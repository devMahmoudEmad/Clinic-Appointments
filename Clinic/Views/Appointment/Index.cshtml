@model AppointmentIndexViewModel
@{
    ViewData["Title"] = "Appointments";
}

<h1>Appointments</h1>

<form method="get" class="row g-3 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label" asp-for="Date">Date</label>
        <input type="date" class="form-control" asp-for="Date" id="Date" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <label class="form-label" asp-for="DoctorId">Doctor</label>
        <select class="form-select" asp-for="DoctorId" asp-items="Model.Doctors">
            <option value="">All doctors</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label" asp-for="PatientName">Patient</label>
        <input class="form-control" asp-for="PatientName" placeholder="Patient name" />
    </div>
    <div class="col-auto">
        <label class="form-label" asp-for="Status">Status</label>
        <select class="form-select" asp-for="Status">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<AppointmentStatus>())
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Status</th>
                <th>edit</th>
                <th>cancel</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in Model.Appointments)
            {
                <tr>
                    <td>@appointment.AppointmentDate.ToString("dd/MM/yyyy")</td>
                    <td>@appointment.StartTime.ToString("HH:mm") – @appointment.EndTime.ToString("HH:mm")</td>
                    <td>@appointment.PatientName</td>
                    <td>@appointment.DoctorName</td>
                    <td>
                        <span class="badge @(appointment.Status switch {
                            "Scheduled" => "text-bg-primary",
                            "Completed" => "text-bg-success",
                            "Cancelled" => "text-bg-secondary",
                            _ => "text-bg-light" })">
                            @appointment.Status
                        </span>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@appointment.AppointmentId">Edit</a>
                    </td>
                    <td>
                        @if (appointment.Status == "Scheduled")
                        {
                            <form asp-action="Cancel" asp-route-id="@appointment.AppointmentId" method="post" class="d-inline"
                                  onsubmit="return confirm('Cancel this appointment?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Appointments.Count == 0)
    {
        <p class="text-muted">No appointments match the current filter.</p>
    }

    <div class="mt-2">
        <partial name="_Pagination" model="Model" />
    </div>
</div>
