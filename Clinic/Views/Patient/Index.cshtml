@model PatientSearchViewModel
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Patients</h1>
    <a class="btn btn-primary" asp-action="Create">Register Patient</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input class="form-control" asp-for="SearchTerm" placeholder="Search by name or phone" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Birth Date</th>
                <th>Gender</th>
                <th>Phone</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model.Patients)
            {
                <tr>
                    <td>@patient.Name</td>
                    <td>@patient.BirthDate.ToString("dd/MM/yyyy")</td>
                    <td>@patient.Gender</td>
                    <td>@patient.Phone</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Appointment" asp-action="Create" asp-route-patientId="@patient.PatientId">New Appointment</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@patient.PatientId">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Patients.Count == 0)
    {
        <p class="text-muted">No patients found.</p>
    }

    <div class="mt-2">
        <partial name="_Pagination" model="Model" />
    </div>
</div>
